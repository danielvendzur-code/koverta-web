ator?page=zahrada&amp;w=5000&amp;l=3000" tabindex="-1" aria-hidden="true">3D</a></span><span class="kh-size__kus"><a class="kh-size__chip" href="/pages/nove-zahradne-pristresky-rozmer-5000x4000" aria-label="Pozrieť rozmer 5 m × 4 m"><span>4 m</span><small>od 5 797 €</small></a><a class="kh-size__cfg" href="/pages/nove-konfigurator?page=zahrada&amp;w=5000&amp;l=4000" tabindex="-1" aria-hidden="true">3D</a></span></div></div><div class="kh-size__rad"><p class="kh-size__sirka"><strong>6 m</strong><span>šírka</span></p><div class="kh-size__dlzky"><span class="kh-size__kus"><a class="kh-size__chip" href="/pages/nove-zahradne-pristresky-rozmer-6000x3000" aria-label="Pozrieť rozmer 6 m × 3 m"><span>3 m</span><small>od 6 097 €</small></a><a class="kh-size__cfg" href="/pages/nove-konfigurator?page=zahrada&amp;w=6000&amp;l=3000" tabindex="-1" aria-hidden="true">3D</a></span><span class="kh-size__kus"><a class="kh-size__chip" href="/pages/nove-zahradne-pristresky-rozmer-6000x4000" aria-label="Pozrieť rozmer 6 m × 4 m"><span>4 m</span><small>od 6 797 €</small></a><a class="kh-size__cfg" href="/pages/nove-konfigurator?page=zahrada&amp;w=6000&amp;l=4000" tabindex="-1" aria-hidden="true">3D</a></span></div></div><details class="kh-size__viac"><summary><span>Zobraziť ďalších 4 rozmerov</span><span class="kh-size__znak" aria-hidden="true"></span></summary><div class="kh-size__zvysok"><div class="kh-size__rad"><p class="kh-size__sirka"><strong>7 m</strong><span>šírka</span></p><div class="kh-size__dlzky"><span class="kh-size__kus"><a class="kh-size__chip" href="/pages/nove-zahradne-pristresky-rozmer-7000x3000" aria-label="Pozrieť rozmer 7 m × 3 m"><span>3 m</span><small>od 7 097 €</small></a><a class="kh-size__cfg" href="/pages/nove-konfigurator?page=zahrada&amp;w=7000&amp;l=3000" tabindex="-1" aria-hidden="true">3D</a></span><span class="kh-size__kus"><a class="kh-size__chip" href="/pages/nove-zahradne-pristresky-rozmer-7000x4000" aria-label="Pozrieť rozmer 7 m × 4 m"><span>4 m</span><small>od 7 797 €</small></a><a class="kh-size__cfg" href="/pages/nove-konfigurator?page=zahrada&amp;w=7000&amp;l=4000" tabindex="-1" aria-hidden="true">3D</a></span></div></div><div class="kh-size__rad"><p class="kh-size__sirka"><strong>8 m</strong><span>šírka</span></p><div class="kh-size__dlzky"><span class="kh-size__kus"><a class="kh-size__chip" href="/pages/nove-zahradne-pristresky-rozmer-8000x3000" aria-label="Pozrieť rozmer 8 m × 3 m"><span>3 m</span><small>od 8 397 €</small></a></span><span class="kh-size__kus"><a class="kh-size__chip" href="/pages/nove-zahradne-pristresky-rozmer-8000x4000" aria-label="Pozrieť rozmer 8 m × 4 m"><span>4 m</span><small>od 9 297 €</small></a></span></div></div></div></details></div></div>

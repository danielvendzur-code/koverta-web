<!-- ===================================================== SKLADBA -->
<!-- Zákazník sa pri vlastnej výrobe Koverta pýta na to isté, čo pri Soltecu:
     z čoho to je a čo je pod tým. Táto tabuľka odpovedá na jednom mieste. -->
<section class="k-band k-biela kh-mat" aria-labelledby="anaTitle">
  <div class="k-rules" aria-hidden="true"></div>
  <div class="k-wrap">
    <header class="k-head k-head--split">
      <div class="k-head__title">
        <p class="k-eyebrow k-rise">Z čoho je to postavené</p>
        <h2 id="anaTitle" class="k-h2 k-rise" data-k-headline data-k-delay="1">Všetko doriešime skôr, než začneme vyrábať</h2>
      </div>
      <div class="k-rise" data-k-delay="2">
        <p class="k-copy">Rozmer, spád strechy, bočné výplne a elektroprípravu riešime pred výrobou podľa konkrétneho miesta.</p>
        <a class="k-btn k-btn--line" href="#ponuka">Prejsť na nezáväznú ponuku <svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
    </header>
    <div class="kh-mat__grid">
      <article class="kh-mat__card k-rise" data-k-delay="1">
        <div class="kh-mat__media"><img width="1280" height="960" src="https://danielvendzur-code.github.io/koverta-web/assets/koverta-zahradny-pristresok-skalica-terasa.jpg" alt="Pultová strecha záhradného prístrešku Koverta nad dreveným podíom" decoding="async" loading="lazy" srcset="https://danielvendzur-code.github.io/koverta-web/assets/koverta-zahradny-pristresok-skalica-terasa-w640.webp 640w, https://danielvendzur-code.github.io/koverta-web/assets/koverta-zahradny-pristresok-skalica-terasa-w1000.webp 1000w" sizes="(max-width: 900px) 271px, 460px" title="Pultová strecha záhradného prístrešku Koverta"></div>
        <div class="kh-mat__body">
          <p class="kh-mat__label">Strecha</p>
          <h3 class="kh-mat__title">Pultová trapézová strecha</h3>
          <p class="kh-mat__text">Pod strechou nebubnuje dážď a v lete sa pod ňou nedá zohriať. Odkvap, zvod aj izolácia sú v základnej cene, nie ako príplatok.</p><div class="kh-mat__pata"><div class="kh-mat__udaj"><p class="kh-mat__pojem">Strecha</p><p class="kh-mat__hodnota">pultová, trapéz</p></div><div class="kh-mat__udaj"><p class="kh-mat__pojem">V cene</p><p class="kh-mat__hodnota">odkvap + izolácia</p></div></div>
        </div>
      </article>
      <article class="kh-mat__card k-rise" data-k-delay="2">
        <div class="kh-mat__media"><img src="https://danielvendzur-code.github.io/koverta-web/assets/koverta-pristresok-drevene-lamely-bocna-vypln.jpg" width="1600" height="1200" alt="Bočná výplň záhradného prístrešku Koverta z drevených lamiel" decoding="async" loading="lazy" srcset="https://danielvendzur-code.github.io/koverta-web/assets/koverta-pristresok-drevene-lamely-bocna-vypln-w640.webp 640w, https://danielvendzur-code.github.io/koverta-web/assets/koverta-pristresok-drevene-lamely-bocna-vypln-w1000.webp 1000w, https://danielvendzur-code.github.io/koverta-web/assets/koverta-pristresok-drevene-lamely-bocna-vypln-w1600.webp 1600w" sizes="(max-width: 900px) 271px, 460px"></div>
        <div class="kh-mat__body">
          <p class="kh-mat__label">Boky</p>
          <h3 class="kh-mat__title">Drevo, WPC alebo hliník</h3>
          <p class="kh-mat__text">Bok zakryjeme drevom, WPC alebo hliníkom podľa toho, či má prístrešok pôsobiť teplo alebo čisto. Vyberáme to spolu s vami pri návrhu. Bočné výplne nie sú v základnej cene prístrešku a účtujú sa samostatne.</p><div class="kh-mat__pata"><div class="kh-mat__udaj"><p class="kh-mat__pojem">Výplne</p><p class="kh-mat__hodnota">drevo / WPC / hliník</p></div><div class="kh-mat__udaj"><p class="kh-mat__pojem">Cena</p><p class="kh-mat__hodnota">za príplatok</p></div></div>
        </div>
      </article>
      <article class="kh-mat__card k-rise" data-k-delay="3">
        <div class="kh-mat__media"><img src="https://danielvendzur-code.github.io/koverta-web/assets/koverta-zahradny-pristresok-antracit-lamelova-stena.jpg" width="1280" height="960" alt="Antracitový záhradný prístrešok Koverta nad terasou s lamelovou bočnou stenou" title="Sedenie pod záhradným prístreškom Koverta" decoding="async" loading="lazy" srcset="https://danielvendzur-code.github.io/koverta-web/assets/koverta-zahradny-pristresok-antracit-lamelova-stena-w640.webp 640w, https://danielvendzur-code.github.io/koverta-web/assets/koverta-zahradny-pristresok-antracit-lamelova-stena-w1000.webp 1000w" sizes="(max-width: 900px) 271px, 460px"></div>
        <div class="kh-mat__body">
          <p class="kh-mat__label">Rám</p>
          <h3 class="kh-mat__title">Oceľová nosná konštrukcia</h3>
          <p class="kh-mat__text">Oceľ ponorená do zinku a navrch lakovaná. Znamená to, že prístrešok už nikdy nebudete natierať, stačí ho raz za čas opláchnuť vodou.</p><div class="kh-mat__pata"><div class="kh-mat__udaj"><p class="kh-mat__pojem">Materiál</p><p class="kh-mat__hodnota">oceľ</p></div><div class="kh-mat__udaj"><p class="kh-mat__pojem">Povrch</p><p class="kh-mat__hodnota">zinok pod lakom</p></div></div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ===================================================== ROZMERY -->

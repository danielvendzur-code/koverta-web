{%- comment -%} Vzhľad lišty Consentik: okno v strede obrazovky so stlmeným
  pozadím, písmo a tlačidlá ako na webe, Súhlasím ako hlavné tlačidlo.
  Centruje sa cez inset + margin:auto, nie cez transform, aby sa nebilo
  s vlastnou animáciou aplikácie. {%- endcomment -%}
<style>
  .otCookiesNotification, .otCookiesNotification * {
    font-family: "Archivo", "Helvetica Neue", Arial, sans-serif !important;
    letter-spacing: 0 !important;
    box-sizing: border-box;
  }
  .otCookiesNotification #cookies-wrapper {
    position: fixed !important;
    inset: 0 !important;
    margin: auto !important;
    width: min(500px, calc(100vw - 32px)) !important;
    max-width: none !important;
    height: fit-content !important;
    max-height: calc(100vh - 32px) !important;
    overflow: auto !important;
    transform: none !important;
    translate: none !important;
    z-index: 2147483000 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 14px !important;
    padding: 30px 28px 26px !important;
    background: #fff !important;
    color: #12171a !important;
    border: 0 !important;
    border-radius: 20px !important;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28), 0 0 0 100vmax rgba(12, 15, 17, 0.5) !important;
    text-align: left !important;
    font-size: 14.5px !important;
    line-height: 1.55 !important;
  }
  .otCookiesNotification #cookies-wrapper > * { width: 100% !important; max-width: none !important; margin: 0 !important; text-align: left !important; }
  .otCookiesNotification .otCookies-title-banner,
  .otCookiesNotification [class*="title"] {
    color: #12171a !important;
    font-size: 21px !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    text-align: left !important;
    padding-right: 28px !important;
  }
  .otCookiesNotification p,
  .otCookiesNotification [class*="content"],
  .otCookiesNotification [class*="message"],
  .otCookiesNotification [class*="desc"] {
    color: rgba(18, 23, 26, 0.7) !important;
    font-size: 14.5px !important;
    line-height: 1.55 !important;
    text-align: left !important;
  }
  .otCookiesNotification a {
    color: #12171a !important;
    font-size: 13.5px !important;
    text-decoration: underline !important;
    text-underline-offset: 3px;
  }
  .otCookiesNotification [class*="policy"],
  .otCookiesNotification [class*="link"] { justify-content: flex-start !important; gap: 6px 18px !important; flex-wrap: wrap !important; }
  .otCookiesNotification .ot-group-btn-corner,
  .otCookiesNotification [class*="group-btn"] {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 10px !important;
    width: 100% !important;
    margin-top: 6px !important;
  }
  .otCookiesNotification button.cookies-btn,
  .otCookiesNotification [class*="group-btn"] button {
    width: 100% !important;
    min-height: 48px !important;
    margin: 0 !important;
    padding: 10px 18px !important;
    border-radius: 999px !important;
    border: 1.5px solid rgba(18, 23, 26, 0.22) !important;
    background: #fff !important;
    color: #12171a !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    box-shadow: none !important;
    cursor: pointer;
  }
  /* Súhlasím je posledné tlačidlo: hlavné, na celú šírku a navrchu. */
  .otCookiesNotification [class*="group-btn"] button:last-child,
  .otCookiesNotification button.cookies-btn[class*="accept" i],
  .otCookiesNotification button[id*="accept" i] {
    grid-column: 1 / -1 !important;
    order: -1 !important;
    background: #12171a !important;
    border-color: #12171a !important;
    color: #fff !important;
  }
  .otCookiesNotification button:hover { opacity: 0.88 !important; }
  .otCookiesNotification button:focus-visible { outline: 2px solid #FFCC00 !important; outline-offset: 2px; }
  @media (max-width: 480px) {
    .otCookiesNotification #cookies-wrapper { padding: 24px 20px 20px !important; }
    .otCookiesNotification .otCookies-title-banner, .otCookiesNotification [class*="title"] { font-size: 19px !important; }
  }
</style>

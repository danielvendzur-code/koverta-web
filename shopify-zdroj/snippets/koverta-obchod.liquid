{%- comment -%}
  Šablóny obchodu, ktoré web nemá ako stránku: kolekcia, zoznam kolekcií,
  vyhľadávanie, blog a článok. Staré adresy z Google tak po prepnutí témy
  nespadnú do prázdna — ukážu obsah v dizajne webu a vedú na nové stránky.
{%- endcomment -%}
{{ 'koverta-product.css' | asset_url | stylesheet_tag }}
<main class="k kp ko" id="obsah">
  <section class="kp-top ko-hlava">
    <div class="k-wrap">
      <nav class="kh-crumbs kp-crumbs" aria-label="Kde sa nachádzate"><a href="/">Koverta</a><span aria-hidden="true">/</span>
        {%- case druh -%}
          {%- when 'kolekcia' -%}<span aria-current="page">{{ collection.title }}</span>
          {%- when 'kolekcie' -%}<span aria-current="page">Ponuka</span>
          {%- when 'hladanie' -%}<span aria-current="page">Vyhľadávanie</span>
          {%- when 'blog' -%}<span aria-current="page">{{ blog.title }}</span>
          {%- when 'clanok' -%}<a href="{{ blog.url }}">{{ blog.title }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ article.title }}</span>
        {%- endcase -%}
      </nav>
      {%- case druh -%}
        {%- when 'kolekcia' -%}
          <h1 class="kp-title">{{ collection.title }}</h1>
          {%- if collection.description != blank -%}<div class="k-copy ko-popis">{{ collection.description }}</div>{%- endif -%}
        {%- when 'kolekcie' -%}
          <h1 class="kp-title">Čo potrebujete zastrešiť</h1>
        {%- when 'hladanie' -%}
          <h1 class="kp-title">{% if search.performed %}Výsledky pre „{{ search.terms | escape }}“{% else %}Vyhľadávanie{% endif %}</h1>
          <form class="ko-hladat" action="/search" method="get" role="search">
            <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Napríklad prístrešok 5 × 6" aria-label="Hľadať">
            <input type="hidden" name="options[prefix]" value="last">
            <button class="k-btn k-btn--primary" type="submit">Hľadať</button>
          </form>
        {%- when 'blog' -%}
          <h1 class="kp-title">{{ blog.title }}</h1>
        {%- when 'clanok' -%}
          <h1 class="kp-title">{{ article.title }}</h1>
          <p class="kp-istota">{{ article.published_at | date: '%-d. %-m. %Y' }}</p>
      {%- endcase -%}
    </div>
  </section>

  <section class="k-band ko-telo">
    <div class="k-wrap">
      {%- case druh -%}
        {%- when 'kolekcia' -%}
          {%- if collection.handle == 'pristresky-pre-auta' or collection.handle == 'zahradne-pristresky' -%}
            {%- if collection.handle == 'zahradne-pristresky' -%}{%- assign rodina = 'zahrada' -%}{%- assign stranka = '/pages/nove-zahradne-pristresky' -%}{%- else -%}{%- assign rodina = 'auto' -%}{%- assign stranka = '/pages/nove-pristresky-pre-auta' -%}{%- endif -%}
            <div class="kh-work kp-rozmery">{% render 'koverta-rozmery', family: rodina, product: nil %}</div>
            <p class="ko-dalej"><a class="k-btn k-btn--line" href="{{ stranka }}">Všetko o {% if rodina == 'zahrada' %}záhradných prístreškoch{% else %}prístreškoch pre autá{% endif %}</a> <a class="k-btn k-btn--primary" href="/pages/nove-konfigurator">3D konfigurátor</a></p>
          {%- else -%}
            {% render 'koverta-obchod-rozcestnik' %}
          {%- endif -%}
        {%- when 'kolekcie' -%}
          {% render 'koverta-obchod-rozcestnik' %}
        {%- when 'hladanie' -%}
          {%- if search.performed -%}
            {%- if search.results_count == 0 -%}
              <p class="k-copy">Nič sme nenašli. Skúste iné slovo, alebo nám rovno napíšte, čo potrebujete zastrešiť.</p>
              {% render 'koverta-obchod-rozcestnik' %}
            {%- else -%}
              <ul class="ko-vysledky">
                {%- for item in search.results -%}
                  {%- if item.object_type == 'product' -%}{%- if item.metafields.koverta.family == blank -%}{%- continue -%}{%- endif -%}{%- endif -%}
                  <li><a href="{{ item.url }}"><strong>{{ item.title }}</strong>
                    {%- if item.object_type == 'product' -%}<small>{% render 'koverta-cena', centy: item.price %} · s DPH, dopravou a montážou</small>
                    {%- elsif item.object_type == 'article' -%}<small>Realizácia</small>
                    {%- else -%}<small>Stránka</small>{%- endif -%}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- else -%}
            {% render 'koverta-obchod-rozcestnik' %}
          {%- endif -%}
        {%- when 'blog' -%}
          <div class="ko-clanky">
            {%- for a in blog.articles -%}
              <a class="ko-clanok" href="{{ a.url }}">
                {%- if a.image -%}<img src="{{ a.image | image_url: width: 900 }}" width="{{ a.image.width }}" height="{{ a.image.height }}" alt="{{ a.image.alt | default: a.title | escape }}" loading="lazy">{%- endif -%}
                <strong>{{ a.title }}</strong>
              </a>
            {%- endfor -%}
          </div>
          <p class="ko-dalej"><a class="k-btn k-btn--primary" href="/pages/nove-realizacie">Všetky realizácie na mape</a></p>
        {%- when 'clanok' -%}
          <article class="ko-text">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 1600 }}" width="{{ article.image.width }}" height="{{ article.image.height }}" alt="{{ article.image.alt | default: article.title | escape }}">{%- endif -%}
            {{ article.content }}
          </article>
          <p class="ko-dalej"><a class="k-btn k-btn--line" href="/pages/nove-realizacie">Ďalšie realizácie</a> <a class="k-btn k-btn--primary" href="/pages/nove-kontakt#ponuka">Nezáväzná cenová ponuka</a></p>
      {%- endcase -%}
    </div>
  </section>
</main>

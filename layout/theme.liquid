<link rel="stylesheet" href="{{ 'koverta-2026.css' | asset_url }}">
</head>
<body class="{% if template.name == 'index' %}k-home{% endif %}">
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5KVNNWW5" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
<script>
  /* Skripty nesú v sebe cesty statického webu. Tu dostanú tie, ktoré platia
     v obchode: obrázky značiek a modely vybavenia sú na CDN, stránka
     o 3D modeloch je v /pages/. */
  window.KV_ADRESY = {
    znackaKoverta: {{ 'koverta-mark.svg' | asset_url | json }},
    znackaSoltec: "https://danielvendzur-code.github.io/koverta-web/assets/soltec-mark.png",
    modely: '/pages/nove-pouzite-modely'
  };
  /* Cesty, ktoré koverta-2026.js nesie rovno v texte a skladá z nich
     fotografie a odkazy vo výbere riešenia. V značkovaní nie sú, takže ich
     prevod inak nevidí; bez tejto tabuľky by na Shopify ukazovali na
     /pages/assets/… a /carport-soltec/, teda nikam. */
  window.KV_CESTY = {
    "./pristresky-pre-auta/": "/collections/pristresky-pre-auta",
    "./assets/koverta-pristresok-auto-golf-lamelova-stena.jpg": "https://danielvendzur-code.github.io/koverta-web/assets/koverta-pristresok-auto-golf-lamelova-stena.jpg",
    "./carport-soltec/": "/collections/pristresky-pre-auta-agava",
    "./assets/soltec-carport-toth-nitra-hero.jpg": "https://danielvendzur-code.github.io/koverta-web/assets/soltec-carport-toth-nitra-hero.jpg",
    "./zahradne-pristresky/": "/collections/zahradne-pristresky",
    "./assets/koverta-zahradny-pristresok-antracit-lamelova-stena.jpg": "https://danielvendzur-code.github.io/koverta-web/assets/koverta-zahradny-pristresok-antracit-lamelova-stena.jpg",
    "./bioklimaticke-pergoly/": "/collections/bioklimaticke-pergoly",
    "./assets/soltec-pergola-pri-bazene-antracit.jpg": "https://danielvendzur-code.github.io/koverta-web/assets/soltec-pergola-pri-bazene-antracit.jpg",
    "./pevne-prestresenia/": "/collections/pergoly-s-pevnou-strechou-multiport",
    "./assets/soltec-pergola-plna-strecha-pri-dome.webp": "https://danielvendzur-code.github.io/koverta-web/assets/soltec-pergola-plna-strecha-pri-dome.webp",
    "./tienenie/": "/collections/tienenie",
    "./assets/soltec-pergola-zip-rolety-a-pevne-vyplne.jpg": "https://danielvendzur-code.github.io/koverta-web/assets/soltec-pergola-zip-rolety-a-pevne-vyplne.jpg",
    "./outdoor-kuchyne/": "/collections/outdoor-kuchyne",
    "./assets/soltec-outdoor-kuchyna-graz.jpg": "https://danielvendzur-code.github.io/koverta-web/assets/soltec-outdoor-kuchyna-graz.jpg",
    "./assets/koverta-mark.svg": "{{ 'koverta-mark.svg' | asset_url }}",
    "./assets/soltec-mark.png": "https://danielvendzur-code.github.io/koverta-web/assets/soltec-mark.png",
    "./dakujeme/": "/pages/dakujeme"
  };
  window.KV_SCENE_ASSETS = "https://danielvendzur-code.github.io/koverta-web/konfigurator/scene-assets/";
</script>
{% section 'kv-hlavicka' %}
{{ content_for_layout }}
{% section 'kv-paticka' %}
{%- unless template.name == 'product' or page.handle == 'konfigurator' or page.handle == 'nove-konfigurator' -%}
<div class="kh-dock" aria-label="Rýchly kontakt">
  <a class="kh-dock__call" href="tel:+421948482266" aria-label="Zavolať"><svg viewBox="0 0 24 24"><path d="M6.6 3.5 9.4 8 7.8 9.8c1.2 2.4 3.1 4.3 5.5 5.5l1.8-1.6 4.4 2.8-.8 3.1c-.2.7-.8 1.2-1.5 1.2C9.5 20.8 3.2 14.5 3.2 6.8c0-.7.5-1.3 1.2-1.5l2.2-.8Z" stroke-linejoin="round"/></svg></a>
  <a class="k-btn k-btn--primary" href="/pages/kontakt#ponuka">Nezáväzná cenová ponuka</a>
</div>
{%- endunless -%}
<script src="{{ 'koverta-2026.js' | asset_url }}" defer></script>
</body>
</html>

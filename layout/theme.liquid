<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% render 'kv-consentik' %}
<!-- Značky pre vyhľadávače.

     Prevod ich zo stránok zahadzuje, lebo na Shopify ich skladá obchod —
     lenže content_for_header medzi ne titulok ani popis nedáva, tie patria
     šablóne. Kým ich tu nebolo, nemala žiadna stránka témy titulok vôbec.

     Berú sa z políčok „Search engine listing" pri stránke, teda z toho, čo je
     v štvrtom a piatom stĺpci STRANKY-NA-ZALOZENIE.txt. Vlastné sem
     nepíšeme: stáli by v hlavičke dvakrát a Google by druhý ignoroval.
     Adresu canonical dáva Shopify a je to jeho adresa, nie naša. -->
{%- assign kv_titulok = page_title -%}
{%- assign kv_popis = page_description -%}
{%- comment -%} Úvod berie titulok a popis z webu, nie zo starých nastavení obchodu. {%- endcomment -%}
{%- if template.name == 'index' -%}
{%- assign kv_titulok = "Koverta | prístrešky pre autá, pergoly a 3D konfigurátor" -%}
{%- assign kv_popis = "Prístrešky pre autá, pergoly a zastrešenie terás z vlastnej výroby aj Soltec. 3D konfigurátor s cenou, zameranie zadarmo, hodnotenie 5,0 na Google." -%}
{%- endif -%}
{%- if request.page_type == 'page' -%}{%- case page.handle -%}
{%- when 'nove-404' -%}{%- assign kv_titulok = 'Stránka sa nenašla | Koverta' -%}{%- assign kv_popis = 'Táto adresa na webe Koverta neexistuje. Nájdite prístrešky, pergoly, tienenie alebo konfigurátor.' -%}
{%- when 'nove-bioklimaticke-pergoly', 'bioklimaticke-pergoly', 'galeria-bioklimaticke-pergoly' -%}{%- assign kv_titulok = 'Bioklimatické pergoly Soltec s otočnými lamelami | Koverta' -%}{%- assign kv_popis = 'Prémiová hliníková pergola Soltec s otočnými lamelami: tieň, vzduch aj ochrana pred dažďom. Šesť modelov SL, 3D konfigurátor, montáž po celom Slovensku.' -%}
{%- when 'nove-carport-soltec', 'galeria-pristresky-agava' -%}{%- assign kv_titulok = 'Prémiový hliníkový prístrešok pre auto Soltec | Koverta' -%}{%- assign kv_popis = 'Prémiové celohliníkové carporty Soltec pre 1 až 3 autá, voda odteká vnútri stĺpov. Rady F a SL, 3D konfigurátor s cenou, doprava a montáž v cene.' -%}
{%- when 'nove-dakujeme', 'dakujeme' -%}{%- assign kv_titulok = 'Ďakujeme | Koverta' -%}{%- assign kv_popis = 'Dopyt sme prijali. Ozveme sa do jedného pracovného dňa.' -%}
{%- when 'nove-konfigurator', 'konfigurator' -%}{%- assign kv_titulok = 'Konfigurátor prístreškov a pergol v 3D s cenou | Koverta' -%}{%- assign kv_popis = 'Online 3D konfigurátor: prístrešok pre auto, hliníkový carport Soltec, záhradný prístrešok, prestrešenie aj pergola s otočnými lamelami. Cena hneď.' -%}
{%- when 'nove-kontakt', 'kontakt' -%}{%- assign kv_titulok = 'Kontakt | prístrešky a pergoly Koverta' -%}{%- assign kv_popis = 'Zameranie aj cenová ponuka sú zadarmo a nezáväzné. Volajte +421 948 482 266, píšte na obchod@koverta.sk alebo pošlite dopyt s fotkami.' -%}
{%- when 'nove-obchodne-podmienky', 'vseobecne-obchodne-podmienky' -%}{%- assign kv_titulok = 'Obchodné podmienky | Koverta' -%}{%- assign kv_popis = 'Práva a povinnosti pri zmluve o dielo uzatvorenej na diaľku, od objednávky po odovzdanie.' -%}
{%- when 'nove-ochrana-sukromia', 'zasady-ochrany-osobnych-udajov', 'informacie-o-cookies' -%}{%- assign kv_titulok = 'Ochrana súkromia | Koverta' -%}{%- assign kv_popis = 'Osobné údaje spracúvame podľa GDPR a zákona č. 18/2018 Z. z. Tu je, čo o vás uchovávame, prečo a ako dlho.' -%}
{%- when 'nove-outdoor-kuchyne', 'vonkajsie-kuchyne' -%}{%- assign kv_titulok = 'Vonkajšie kuchyne Soltec | Koverta' -%}{%- assign kv_popis = 'Prémiové vonkajšie kuchyne Soltec do zastrešenej terasy aj pod pergolu. Hliníková konštrukcia, hliníkový obklad a kamenná doska 2 cm. Montáž v cene.' -%}
{%- when 'nove-pevne-prestresenia', 'pergoly-s-pevnou-strechou-multiport' -%}{%- assign kv_titulok = 'Pevné prestrešenie terasy Soltec, 3D konfigurátor | Koverta' -%}{%- assign kv_popis = 'Prémiové prestrešenie terasy Soltec so zatepleným panelom 3 cm, bezpečnostným sklom alebo zelenou strechou. 3D konfigurátor, doprava a montáž v cene.' -%}
{%- when 'nove-pouzite-modely', 'pouzite-modely' -%}{%- assign kv_titulok = 'O 3D modeloch | Koverta' -%}{%- assign kv_popis = 'Autori a licencie 3D modelov áut a posedenia, ktoré sa zobrazujú v konfigurátore Koverta.' -%}
{%- when 'nove-pristresky-pre-auta', 'pristresky-pre-auta', 'o-pristreskoch-pre-auta' -%}{%- assign kv_titulok = 'Prístrešky pre autá na mieru, 3D konfigurátor | Koverta' -%}{%- assign kv_popis = 'Oceľové prístrešky pre 1 až 3 autá z vlastnej výroby, do 8 m bez stredového stĺpa. Rozmer si nastavíte v 3D konfigurátore s cenou. Montáž v cene.' -%}
{%- when 'nove-produkty', 'produkty' -%}{%- assign kv_titulok = 'Všetky produkty | Koverta' -%}{%- assign kv_popis = 'Prehľad všetkého, čo Koverta vyrába a montuje: oceľové prístrešky pre autá, záhradné prístrešky, bioklimatické pergoly Soltec, tienenie a vonkajšie kuchyne.' -%}
{%- when 'nove-realizacie', 'galeria-pristresky-pre-auta', 'galeria-zahradne-pristresky' -%}{%- assign kv_titulok = 'Realizácie prístreškov a pergol | Koverta' -%}{%- assign kv_popis = 'Prístrešky, pergoly a zastrešenia terás, ktoré sme postavili u zákazníkov vo viac ako 110 obciach na Slovensku. Fotografie z montáží podľa typu riešenia.' -%}
{%- when 'nove-reklamacie', 'reklamacny-poriadok' -%}{%- assign kv_titulok = 'Reklamačný poriadok | Koverta' -%}{%- assign kv_popis = 'Ako a kde reklamovať, ako postupujeme pri riešení a ako prebiehajú záručné opravy.' -%}
{%- when 'nove-tienenie', 'tienenie' -%}{%- assign kv_titulok = 'Tienenie terás a pergol Soltec | Koverta' -%}{%- assign kv_popis = 'Prémiové vonkajšie tienenie Soltec: ZIP rolety K130, posuvné panely H50, pevné steny, sklo G1/G2 a otočné lamely E300. Montáž po celom Slovensku.' -%}
{%- when 'nove-zahradne-pristresky', 'pre-dom-a-zahradu', 'o-zahradnych-pristreskoch' -%}{%- assign kv_titulok = 'Záhradné prístrešky a pergoly, 3D konfigurátor | Koverta' -%}{%- assign kv_popis = 'Záhradné prístrešky Koverta nad terasu, vstup či posedenie. Oceľ, strecha z trapézu alebo sendviča, bočné výplne. 3D konfigurátor s cenou, montáž v cene.' -%}
{%- endcase -%}
{%- elsif request.page_type == 'collection' -%}{%- case collection.handle -%}
{%- when 'bioklimaticke-pergoly' -%}{%- assign kv_titulok = 'Bioklimatické pergoly Soltec s otočnými lamelami | Koverta' -%}{%- assign kv_popis = 'Prémiová hliníková pergola Soltec s otočnými lamelami: tieň, vzduch aj ochrana pred dažďom. Šesť modelov SL, 3D konfigurátor, montáž po celom Slovensku.' -%}
{%- when 'pristresky-pre-auta-agava' -%}{%- assign kv_titulok = 'Prémiový hliníkový prístrešok pre auto Soltec | Koverta' -%}{%- assign kv_popis = 'Prémiové celohliníkové carporty Soltec pre 1 až 3 autá, voda odteká vnútri stĺpov. Rady F a SL, 3D konfigurátor s cenou, doprava a montáž v cene.' -%}
{%- when 'outdoor-kuchyne' -%}{%- assign kv_titulok = 'Vonkajšie kuchyne Soltec | Koverta' -%}{%- assign kv_popis = 'Prémiové vonkajšie kuchyne Soltec do zastrešenej terasy aj pod pergolu. Hliníková konštrukcia, hliníkový obklad a kamenná doska 2 cm. Montáž v cene.' -%}
{%- when 'pergoly-s-pevnou-strechou-multiport' -%}{%- assign kv_titulok = 'Pevné prestrešenie terasy Soltec, 3D konfigurátor | Koverta' -%}{%- assign kv_popis = 'Prémiové prestrešenie terasy Soltec so zatepleným panelom 3 cm, bezpečnostným sklom alebo zelenou strechou. 3D konfigurátor, doprava a montáž v cene.' -%}
{%- when 'pristresky-pre-auta' -%}{%- assign kv_titulok = 'Prístrešky pre autá na mieru, 3D konfigurátor | Koverta' -%}{%- assign kv_popis = 'Oceľové prístrešky pre 1 až 3 autá z vlastnej výroby, do 8 m bez stredového stĺpa. Rozmer si nastavíte v 3D konfigurátore s cenou. Montáž v cene.' -%}
{%- when 'tienenie' -%}{%- assign kv_titulok = 'Tienenie terás a pergol Soltec | Koverta' -%}{%- assign kv_popis = 'Prémiové vonkajšie tienenie Soltec: ZIP rolety K130, posuvné panely H50, pevné steny, sklo G1/G2 a otočné lamely E300. Montáž po celom Slovensku.' -%}
{%- when 'zahradne-pristresky' -%}{%- assign kv_titulok = 'Záhradné prístrešky a pergoly, 3D konfigurátor | Koverta' -%}{%- assign kv_popis = 'Záhradné prístrešky Koverta nad terasu, vstup či posedenie. Oceľ, strecha z trapézu alebo sendviča, bočné výplne. 3D konfigurátor s cenou, montáž v cene.' -%}
{%- endcase -%}{%- endif -%}
<title>{{ kv_titulok }}</title>
{%- if kv_popis != blank %}
<meta name="description" content="{{ kv_popis | escape }}">
{%- endif %}
{%- comment -%} Jedna adresa pre jeden obsah vo vyhľadávaní. Staré a nove-* stránky
   ostávajú funkčné (aj pre reklamy), len povedia Google, ktorá adresa je hlavná.
   Zoznam je z tools/adresy-obchodu.json (presmerovania). {%- endcomment -%}
{%- liquid
  assign kv_canon = canonical_url
  case request.path
  when '/pages/pristresky-pre-auta', '/pages/o-pristreskoch-pre-auta', '/pages/nove-pristresky-pre-auta'
    assign kv_canon = shop.url | append: '/collections/pristresky-pre-auta'
  when '/pages/pre-dom-a-zahradu', '/pages/o-zahradnych-pristreskoch', '/pages/nove-zahradne-pristresky'
    assign kv_canon = shop.url | append: '/collections/zahradne-pristresky'
  when '/pages/bioklimaticke-pergoly', '/pages/galeria-bioklimaticke-pergoly', '/pages/nove-bioklimaticke-pergoly'
    assign kv_canon = shop.url | append: '/collections/bioklimaticke-pergoly'
  when '/pages/galeria-zahradne-pristresky', '/pages/nove-realizacie'
    assign kv_canon = shop.url | append: '/pages/galeria-pristresky-pre-auta'
  when '/pages/galeria-pristresky-agava', '/pages/nove-carport-soltec'
    assign kv_canon = shop.url | append: '/collections/pristresky-pre-auta-agava'
  when '/pages/pergoly-s-pevnou-strechou-multiport', '/pages/nove-pevne-prestresenia'
    assign kv_canon = shop.url | append: '/collections/pergoly-s-pevnou-strechou-multiport'
  when '/pages/tienenie', '/pages/nove-tienenie'
    assign kv_canon = shop.url | append: '/collections/tienenie'
  when '/pages/vonkajsie-kuchyne', '/pages/nove-outdoor-kuchyne'
    assign kv_canon = shop.url | append: '/collections/outdoor-kuchyne'
  when '/pages/informacie-o-cookies', '/pages/nove-ochrana-sukromia'
    assign kv_canon = shop.url | append: '/pages/zasady-ochrany-osobnych-udajov'
  when '/pages/nove-kontakt'
    assign kv_canon = shop.url | append: '/pages/kontakt'
  when '/pages/nove-obchodne-podmienky'
    assign kv_canon = shop.url | append: '/pages/vseobecne-obchodne-podmienky'
  when '/pages/nove-reklamacie'
    assign kv_canon = shop.url | append: '/pages/reklamacny-poriadok'
  when '/pages/nove-konfigurator'
    assign kv_canon = shop.url | append: '/pages/konfigurator'
  when '/pages/nove-produkty'
    assign kv_canon = shop.url | append: '/pages/produkty'
  endcase
-%}
<link rel="canonical" href="{{ kv_canon }}">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:locale" content="sk_SK">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:title" content="{{ kv_titulok | escape }}">
<meta property="og:url" content="{{ kv_canon }}">
{%- if kv_popis != blank %}
<meta property="og:description" content="{{ kv_popis | escape }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ kv_titulok | escape }}">
{%- if kv_popis != blank %}
<meta name="twitter:description" content="{{ kv_popis | escape }}">
{%- endif %}
{%- if request.page_type == 'product' and product %}
{%- assign kv_variant = product.selected_or_first_available_variant %}
<meta property="og:price:amount" content="{{ kv_variant.price | divided_by: 100.0 }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
{%- render 'kv-og', page: page, product: product, collection: collection, template: template, request: request %}

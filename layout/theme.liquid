<!doctype html>
<html lang="sk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% render 'kv-consentik' %}
<!-- Značky pre vyhľadávače.

     Prevod ich zo stránok zahadzuje, lebo na Shopify ich skladá obchod —
     lenže content_for_header medzi ne titulok ani popis nedáva, tie patria
     šablóne. Kým ich tu nebolo, nemala žiadna stránka témy titulok vôbec.

     Berú sa z políčok „Search engine listing" pri stránke, teda z toho, čo je
     v štvrtom a piatom stĺpci STRANKY-NA-ZALOZENIE.txt. Vlastné sem
     nepíšeme: stáli by v hlavičke dvakrát a Google by druhý ignoroval.
     Adresu canonical dáva Shopify a je to jeho adresa, nie naša. -->
{%- assign kv_titulok = page_title -%}
{%- assign kv_popis = page_description -%}
{%- comment -%} Úvod berie titulok a popis z webu, nie zo starých nastavení obchodu. {%- endcomment -%}
{%- if template.name == 'index' -%}
{%- assign kv_titulok = "Koverta | prístrešky a pergoly" -%}
{%- assign kv_popis = "Prístrešky pre autá, pergoly a zastrešenie terás z vlastnej výroby. Zameranie a návrh zadarmo, montáž zvyčajne za jeden deň, hodnotenie 5,0 na Google." -%}
{%- endif -%}
{%- if request.page_type == 'page' -%}{%- case page.handle -%}
{%- when 'nove-404' -%}{%- assign kv_titulok = 'Stránka sa nenašla | Koverta' -%}{%- assign kv_popis = 'Táto adresa na webe Koverta neexistuje. Nájdite prístrešky, pergoly, tienenie alebo konfigurátor.' -%}
{%- when 'nove-bioklimaticke-pergoly' -%}{%- assign kv_titulok = 'Bioklimatické pergoly Soltec s otočnými lamelami | Koverta' -%}{%- assign kv_popis = 'Hliníková pergola Soltec s otočnými lamelami reguluje tieň, vzduch a ochranu pred dažďom. Šesť modelov SL, ZIP rolety, sklo a LED. Montáž po celom Slovensku.' -%}
{%- when 'nove-carport-soltec' -%}{%- assign kv_titulok = 'Hliníkový prístrešok pre auto Soltec | Koverta' -%}{%- assign kv_popis = 'Celohliníkové prístrešky Soltec pre jedno až tri autá. Rad F s rovným rámom alebo rad SL s vyššou nosnosťou, voda odteká vnútri stĺpov. Montáž v cene.' -%}
{%- when 'nove-dakujeme', 'dakujeme' -%}{%- assign kv_titulok = 'Ďakujeme | Koverta' -%}{%- assign kv_popis = 'Dopyt sme prijali. Ozveme sa do jedného pracovného dňa.' -%}
{%- when 'nove-konfigurator', 'konfigurator' -%}{%- assign kv_titulok = '3D konfigurátor | Koverta' -%}{%- assign kv_popis = '3D konfigurátor Koverta: prístrešok pre auto, carport Soltec aj bioklimatická pergola. Nastavte rozmer, strechu a farbu a pošlite nám zostavu.' -%}
{%- when 'nove-kontakt', 'kontakt' -%}{%- assign kv_titulok = 'Kontakt | prístrešky a pergoly Koverta' -%}{%- assign kv_popis = 'Zameranie aj cenová ponuka sú zadarmo a nezáväzné. Volajte +421 948 482 266, píšte na obchod@koverta.sk alebo pošlite dopyt s fotkami.' -%}
{%- when 'nove-obchodne-podmienky', 'vseobecne-obchodne-podmienky' -%}{%- assign kv_titulok = 'Obchodné podmienky | Koverta' -%}{%- assign kv_popis = 'Práva a povinnosti pri zmluve o dielo uzatvorenej na diaľku, od objednávky po odovzdanie.' -%}
{%- when 'nove-ochrana-sukromia', 'zasady-ochrany-osobnych-udajov' -%}{%- assign kv_titulok = 'Ochrana súkromia | Koverta' -%}{%- assign kv_popis = 'Osobné údaje spracúvame podľa GDPR a zákona č. 18/2018 Z. z. Tu je, čo o vás uchovávame, prečo a ako dlho.' -%}
{%- when 'nove-outdoor-kuchyne' -%}{%- assign kv_titulok = 'Vonkajšie kuchyne Soltec | Koverta' -%}{%- assign kv_popis = 'Vonkajšie kuchyne Soltec do zastrešenej terasy aj pod pergolu. Hliníková konštrukcia, hliníkový obklad a kamenná doska hrúbky 2 cm. Montáž v cene.' -%}
{%- when 'nove-pevne-prestresenia' -%}{%- assign kv_titulok = 'Pevné prestrešenia | Koverta' -%}{%- assign kv_popis = 'Pevné prestrešenia Soltec s zatepleným panelom hrúbky 3 cm, bezpečnostným sklom alebo zelenou strechou nad terasou, vstupom či pri dome.' -%}
{%- when 'nove-pouzite-modely', 'pouzite-modely' -%}{%- assign kv_titulok = 'O 3D modeloch | Koverta' -%}{%- assign kv_popis = 'Autori a licencie 3D modelov áut a posedenia, ktoré sa zobrazujú v konfigurátore Koverta.' -%}
{%- when 'nove-pristresky-pre-auta' -%}{%- assign kv_titulok = 'Prístrešky pre autá | Koverta' -%}{%- assign kv_popis = 'Oceľové prístrešky pre autá z vlastnej výroby, do 8 m bez stredového stĺpa. Žiarový zinok, trapézová strecha, doprava a montáž v cene.' -%}
{%- when 'nove-produkty', 'produkty' -%}{%- assign kv_titulok = 'Všetky produkty | Koverta' -%}{%- assign kv_popis = 'Prehľad všetkého, čo Koverta vyrába a montuje: oceľové prístrešky pre autá, záhradné prístrešky, bioklimatické pergoly Soltec, tienenie a vonkajšie kuchyne.' -%}
{%- when 'nove-realizacie', 'galeria-pristresky-pre-auta' -%}{%- assign kv_titulok = 'Realizácie prístreškov a pergol | Koverta' -%}{%- assign kv_popis = 'Prístrešky, pergoly a zastrešenia terás, ktoré sme postavili u zákazníkov vo viac ako 110 obciach na Slovensku. Fotografie z montáží podľa typu riešenia.' -%}
{%- when 'nove-reklamacie', 'reklamacny-poriadok' -%}{%- assign kv_titulok = 'Reklamačný poriadok | Koverta' -%}{%- assign kv_popis = 'Ako a kde reklamovať, ako postupujeme pri riešení a ako prebiehajú záručné opravy.' -%}
{%- when 'nove-tienenie' -%}{%- assign kv_titulok = 'Tienenie terás a pergol Soltec | Koverta' -%}{%- assign kv_popis = 'Vonkajšie tienenie Soltec podľa cieľa: ZIP K130, posuvné H50, pevné FW25/FI30, sklo G1/G2 a otočné E300. Porovnanie použitia a ovládania.' -%}
{%- when 'nove-zahradne-pristresky' -%}{%- assign kv_titulok = 'Záhradné prístrešky a pergoly | Koverta' -%}{%- assign kv_popis = 'Záhradné prístrešky Koverta nad terasu, vstup alebo posedenie. Oceľová konštrukcia, pultová trapézová strecha a bočné výplne na mieru.' -%}
{%- endcase -%}
{%- elsif request.page_type == 'collection' -%}{%- case collection.handle -%}
{%- when 'bioklimaticke-pergoly' -%}{%- assign kv_titulok = 'Bioklimatické pergoly Soltec s otočnými lamelami | Koverta' -%}{%- assign kv_popis = 'Hliníková pergola Soltec s otočnými lamelami reguluje tieň, vzduch a ochranu pred dažďom. Šesť modelov SL, ZIP rolety, sklo a LED. Montáž po celom Slovensku.' -%}
{%- when 'pristresky-pre-auta-agava' -%}{%- assign kv_titulok = 'Hliníkový prístrešok pre auto Soltec | Koverta' -%}{%- assign kv_popis = 'Celohliníkové prístrešky Soltec pre jedno až tri autá. Rad F s rovným rámom alebo rad SL s vyššou nosnosťou, voda odteká vnútri stĺpov. Montáž v cene.' -%}
{%- when 'outdoor-kuchyne' -%}{%- assign kv_titulok = 'Vonkajšie kuchyne Soltec | Koverta' -%}{%- assign kv_popis = 'Vonkajšie kuchyne Soltec do zastrešenej terasy aj pod pergolu. Hliníková konštrukcia, hliníkový obklad a kamenná doska hrúbky 2 cm. Montáž v cene.' -%}
{%- when 'pergoly-s-pevnou-strechou-multiport' -%}{%- assign kv_titulok = 'Pevné prestrešenia | Koverta' -%}{%- assign kv_popis = 'Pevné prestrešenia Soltec s zatepleným panelom hrúbky 3 cm, bezpečnostným sklom alebo zelenou strechou nad terasou, vstupom či pri dome.' -%}
{%- when 'pristresky-pre-auta' -%}{%- assign kv_titulok = 'Prístrešky pre autá | Koverta' -%}{%- assign kv_popis = 'Oceľové prístrešky pre autá z vlastnej výroby, do 8 m bez stredového stĺpa. Žiarový zinok, trapézová strecha, doprava a montáž v cene.' -%}
{%- when 'tienenie' -%}{%- assign kv_titulok = 'Tienenie terás a pergol Soltec | Koverta' -%}{%- assign kv_popis = 'Vonkajšie tienenie Soltec podľa cieľa: ZIP K130, posuvné H50, pevné FW25/FI30, sklo G1/G2 a otočné E300. Porovnanie použitia a ovládania.' -%}
{%- when 'zahradne-pristresky' -%}{%- assign kv_titulok = 'Záhradné prístrešky a pergoly | Koverta' -%}{%- assign kv_popis = 'Záhradné prístrešky Koverta nad terasu, vstup alebo posedenie. Oceľová konštrukcia, pultová trapézová strecha a bočné výplne na mieru.' -%}
{%- endcase -%}{%- endif -%}
<title>{{ kv_titulok }}</title>
{%- if kv_popis != blank %}
<meta name="description" content="{{ kv_popis | escape }}">
{%- endif %}
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:locale" content="sk_SK">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:title" content="{{ kv_titulok | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if kv_popis != blank %}
<meta property="og:description" content="{{ kv_popis | escape }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ kv_titulok | escape }}">
{%- if kv_popis != blank %}
<meta name="twitter:description" content="{{ kv_popis | escape }}">
{%- endif %}
{%- if request.page_type == 'product' and product %}
{%- assign kv_variant = product.selected_or_first_available_variant %}
<meta property="og:price:amount" content="{{ kv_variant.price | divided_by: 100.0 }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
{%- render 'kv-og', page: page, product: product, collection: collection, template: template, request: request %}
{{ content_for_header }}
{{ 'koverta-shopify.css' | asset_url | stylesheet_tag }}

<link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
<link rel="icon" href="https://cdn.jsdelivr.net/gh/danielvendzur-code/koverta-web@7c5f4f673f494c2841e5c1982b0385c5cab33dfd/assets/koverta-ikona-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="https://cdn.jsdelivr.net/gh/danielvendzur-code/koverta-web@7c5f4f673f494c2841e5c1982b0385c5cab33dfd/assets/koverta-ikona-apple.png" sizes="180x180">

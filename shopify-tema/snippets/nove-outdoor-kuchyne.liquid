          <label class="kh-field"><span>Čo by sme mali vedieť?</span><textarea name="contact[body]" rows="3" placeholder="Približný rozmer, počet áut alebo čo chcete zastrešiť"></textarea></label>

          <!-- Fotografie miesta sú pri prístreškoch to najužitočnejšie, čo nám
               viete poslať: z jedného záberu je vidieť podklad, fasádu aj to,
               kam sa dá stĺp postaviť. Pole je nepovinné a znesie viac súborov. -->
          <label class="kh-field kh-field--subor">
            <span>Fotky miesta <small>nepovinné</small></span>
            <input type="file" name="contact[Prílohy][]" accept="image/*,application/pdf" multiple data-k-subory>

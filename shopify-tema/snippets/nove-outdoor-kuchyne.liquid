          <h2 id="ctaTitle" class="k-h2">Získajte ponuku šitú na mieru</h2>
        </div>

        <form id="dopyt" class="kh-form" method="post" action="/pages/kontakt#dopyt" accept-charset="UTF-8" enctype="multipart/form-data" data-k-dopyt>
          <input type="hidden" name="form_type" value="contact">

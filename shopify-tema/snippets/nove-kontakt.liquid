<section class="k-band kh-cta" id="ponuka" aria-labelledby="ctaTitle">
  <div class="k-wrap">
    <div class="kh-cta__grid">

      <div class="kh-cta__card k-rise">
        <div class="kh-cta__head">
          <p class="k-eyebrow">Cenová ponuka zadarmo</p>
          <h2 id="ctaTitle" class="k-h2">Získajte ponuku šitú na mieru</h2>
        </div>

        <form id="dopyt" class="kh-form" method="post" action="/pages/kontakt#dopyt" accept-charset="UTF-8" enctype="multipart/form-data" data-k-dopyt>
          <input type="hidden" name="form_type" value="contact">
          <input type="hidden" name="utf8" value="✓">
          <fieldset>
            <legend>Čo riešite?</legend>
            <div class="kh-select" data-k-select>
              <button class="kh-select__btn" type="button" data-k-select-btn aria-haspopup="listbox" aria-expanded="false">
                <span data-k-select-label>Prístrešok pre auto</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <ul class="kh-select__list" role="listbox" data-k-select-list hidden>
                <li role="option" tabindex="-1" aria-selected="true" data-k-select-option="Prístrešok pre auto">Prístrešok pre auto</li>
                <li role="option" tabindex="-1" aria-selected="false" data-k-select-option="Záhradný prístrešok">Záhradný prístrešok</li>
                <li role="option" tabindex="-1" aria-selected="false" data-k-select-option="Pergola">Pergola</li>
                <li role="option" tabindex="-1" aria-selected="false" data-k-select-option="Tienenie">Tienenie</li>
                <li role="option" tabindex="-1" aria-selected="false" data-k-select-option="Neviem, poraďte">Neviem, poraďte</li>
              </ul>
              <input type="hidden" name="contact[Čo rieši]" value="Prístrešok pre auto" data-k-select-input>
            </div>
          </fieldset>

          <div class="kh-form__grid">
            <label class="kh-field"><span>Meno</span><input type="text" name="contact[name]" autocomplete="name" required></label>
            <label class="kh-field"><span>Telefón</span><input type="tel" name="contact[phone]" inputmode="tel" autocomplete="tel" required></label>
            <label class="kh-field"><span>E-mail</span><input type="email" name="contact[email]" required autocomplete="email"></label>
            <label class="kh-field"><span>Miesto realizácie</span><input type="text" name="contact[Miesto realizácie]" autocomplete="address-level2"></label>
          </div>

          <label class="kh-field"><span>Čo by sme mali vedieť?</span><textarea name="contact[body]" rows="3" placeholder="Približný rozmer, počet áut alebo čo chcete zastrešiť"></textarea></label>

          <!-- Fotografie miesta sú pri prístreškoch to najužitočnejšie, čo nám
               viete poslať: z jedného záberu je vidieť podklad, fasádu aj to,
               kam sa dá stĺp postaviť. Pole je nepovinné a znesie viac súborov. -->
          <label class="kh-field kh-field--subor">
            <span>Fotky miesta <small>nepovinné</small></span>
            <input type="file" name="contact[Prílohy][]" accept="image/*,application/pdf" multiple data-k-subory>
            <small class="kh-field__hint">Stačí pár záberov miesta, kde má prístrešok stáť. Pomôžu nám pri návrhu aj pri cene. Po odoslaní vám ukážeme, kam ich poslať.</small>
          </label>

          <label class="kh-form__suhlas"><input type="checkbox" name="contact[Súhlas]" value="Súhlasím s obchodnými podmienkami a so spracovaním osobných údajov" required><span>Súhlasím s <a href="/pages/vseobecne-obchodne-podmienky">obchodnými podmienkami</a> a so <a href="/pages/zasady-ochrany-osobnych-udajov">spracovaním osobných údajov</a> na účely vybavenia dopytu. Dopyt je nezáväzný.</span></label>

          <div class="kh-form__submit">
            <button class="k-btn k-btn--primary" type="submit">Odoslať dopyt
              <svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
        </form>
        <div class="kh-dakujem" data-k-dakujem hidden>
          <p class="kh-dakujem__znak" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg></p>
          <h3 class="kh-dakujem__nadpis">Dopyt je u nás</h3>
          <p class="kh-dakujem__text">Ozveme sa do jedného pracovného dňa.</p>
          <ol class="kh-dakujem__kroky">
            <li><strong>Ozveme sa</strong></li>
            <li><strong>Pošleme ponuku</strong></li>
            <li><strong>Postavíme</strong><span>Ak treba, predtým prídeme zamerať.</span></li>
          </ol>
          <p class="kh-dakujem__fotky" data-k-fotky hidden>Fotky, ktoré ste vybrali, pošlite prosím e-mailom. Formulár ich k nám neprenesie.
            <a href="mailto:obchod@koverta.sk?subject=Fotky%20k%20dopytu">Poslať fotky na obchod@koverta.sk</a></p>
          <p class="kh-dakujem__spoj">Súri to? <a href="tel:+421948482266">+421 948 482 266</a> · <a href="mailto:obchod@koverta.sk">obchod@koverta.sk</a></p>
          <p class="kh-dakujem__zaloha"><a data-k-mailto href="mailto:obchod@koverta.sk">Poslať ten istý dopyt aj e-mailom</a> <span>Ak by k nám formulár nedoručil, e-mail dôjde vždy.</span></p>
          <button class="k-link" type="button" data-k-znova>Poslať ďalší dopyt <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
        <div class="kh-dakujem kh-dakujem--chyba" data-k-chyba hidden>
          <p class="kh-dakujem__znak" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 7v6" stroke-linecap="round"/><path d="M12 17.2v.1" stroke-linecap="round"/></svg></p>
          <h3 class="kh-dakujem__nadpis">Dopyt sa neodoslal</h3>
          <p class="kh-dakujem__text">Spojenie zlyhalo, takže dopyt k nám nedošiel. Nič ste nestratili, všetko vyplnené vám otvoríme v e-maile jedným klikom:</p>
          <p class="kh-dakujem__zaloha"><a class="k-btn k-btn--primary" data-k-mailto href="mailto:obchod@koverta.sk">Otvoriť e-mail s dopytom<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a> <span>Odíde na obchod@koverta.sk aj s tým, čo ste vyplnili.</span></p>
          <p class="kh-dakujem__spoj">Alebo rovno zavolajte: <a href="tel:+421948482266">+421 948 482 266</a></p>
          <button class="k-link" type="button" data-k-spat>Skúsiť odoslať znova <svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>

      </div>

      <aside class="kh-cta__aside k-rise" data-k-delay="1">
        <div class="kh-cta__aside-head">
          <p class="k-eyebrow">Kompletný servis</p>
          <h3>Od návrhu po montáž</h3>
        </div>

        <!-- Telefón aj e-mail stoja hore v troch dlaždiciach hlavičky. Tu by
             stáli tretíkrát na jednej obrazovke, tak sú preč a panel hovorí
             len to, čo bude nasledovať po odoslaní dopytu. -->
        <!-- Bočný panel držal adresu sídla. Tá odtiaľto odišla — sídlo nie je
             miesto, kam sa oplatí prísť. Namiesto nej stojí to, čo človek na
             kontaktnej stránke naozaj rieši: čo bude nasledovať po odoslaní. -->
        <ol class="kh-cta__steps">
          <li><span>01</span><strong>Ozveme sa</strong></li>
          <li><span>02</span><strong>Pošleme ponuku</strong></li>
          <li><span>03</span><strong>Postavíme</strong><small>Ak treba, predtým prídeme zamerať.</small></li>
        </ol>

        

        <div class="kh-cta__score">
          <span class="kh-fact__row">
            <svg class="k-google k-google--lg" viewBox="0 0 48 48" aria-hidden="true">
              <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
              <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
              <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
              <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
            </svg>
            <b>5,0</b>
            <span class="k-stars" role="img" aria-label="5 z 5"><svg viewBox="0 0 20 20"><path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7 1.6 7.7l5.9-.7z"/></svg><svg viewBox="0 0 20 20"><path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7 1.6 7.7l5.9-.7z"/></svg><svg viewBox="0 0 20 20"><path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7 1.6 7.7l5.9-.7z"/></svg><svg viewBox="0 0 20 20"><path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7 1.6 7.7l5.9-.7z"/></svg><svg viewBox="0 0 20 20"><path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7 1.6 7.7l5.9-.7z"/></svg></span>
          </span>
          <small>Hodnotenie na Google</small>
          <a href="https://www.google.com/maps/search/?api=1&query=Koverta%20Nitra">Prečítať recenzie
            <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>

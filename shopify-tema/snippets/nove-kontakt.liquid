          <span class="kh-rychlo__co">Zavolajte</span>
          <span class="kh-rychlo__hodnota">+421 948 482 266</span>
          <span class="kh-rychlo__pod">Najrýchlejšia cesta k odpovedi</span>
        </a>
      </li>
      <li class="kh-rychlo__kus k-rise" data-k-delay="2">
        <a href="mailto:obchod@koverta.sk">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5.5" width="18" height="13" rx="2.4"/><path d="m3.8 7 7.1 5.2a2 2 0 0 0 2.2 0L20.2 7" stroke-linecap="round"/></svg>
          <span class="kh-rychlo__co">Napíšte</span>
          <span class="kh-rychlo__hodnota">obchod@koverta.sk</span>

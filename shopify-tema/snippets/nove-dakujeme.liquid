<meta name="robots" content="noindex, follow">
<!-- KOVERTA-SEO -->
<link rel="dns-prefetch" href="https://koverta.sk">
<meta name="theme-color" content="#12171a">
<script type="speculationrules">{"prefetch":[{"where":{"href_matches":"/koverta-web/*"},"eagerness":"moderate"}]}</script>

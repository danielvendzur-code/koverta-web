<script>document.documentElement.classList.add('k-js')</script>
<style>
  /* Len pre túto statickú plochu — v téme tieto premenné dodáva Shopify. */
  body { margin: 0; background: #fff; }
  .k, .kv-header {
    --font-heading-family: "Archivo", "Archivo zaskok", "Helvetica Neue", Arial, sans-serif;
    --font-body-family: "Archivo", "Archivo zaskok", "Helvetica Neue", Arial, sans-serif;
  }
  .k h1, .k h2, .k h3, .k .k-display, .k .k-h2, .k .k-h3, .k .k-h4,
  .k .kh-fact strong, .k .kh-rev__big b, .k .kh-cta__row strong,
  .k .kh-usp__item strong, .k .kh-soltec__lines strong, .k .kh-faq__item summary,
  .kv-header .kv-mega__card strong, .k .kh-fact--score b, .k .kh-cta__score b, .k .kh-proc__n {
    font-variation-settings: "wdth" 106;
  }
</style>
<main id="obsah" class="k">
  <section class="k-band kh-cta" aria-labelledby="dakujemeTitle">
    <div class="k-wrap">
      <header class="k-head"><div class="k-head__title">
        <p class="k-eyebrow">Dopyt odoslaný</p>
        <h1 id="dakujemeTitle" class="k-h2">Ďakujeme, dopyt sme prijali</h1>
      </div></header>
      <p class="k-copy">Ozveme sa vám do jedného pracovného dňa. Ak sa ponáhľate, zavolajte na <a href="tel:+421948482266">+421 948 482 266</a> alebo napíšte na <a href="mailto:obchod@koverta.sk">obchod@koverta.sk</a>.</p>
      <p class="k-copy"><a class="k-btn k-btn--line" href="/pages/galeria-pristresky-pre-auta">Všetky realizácie na mape</a></p>
    </div>
  </section>
</main>
<!-- ============================================================ PÄTIČKA -->

<script>
/* ?flat — vypne animácie a odhalí všetko naraz. Len na snímkovanie dizajnu. */
if (new URLSearchParams(location.search).has('flat')) {
  document.querySelectorAll('.k-rise,.k-reveal').forEach((el) => el.classList.add('is-in'));
  const s = document.createElement('style');
  s.textContent = '*{transition:none!important;animation:none!important}.kv-bar{position:static!important}';
  document.head.appendChild(s);
}
</script>

<style>
  /* Len pre túto statickú plochu — v téme tieto premenné dodáva Shopify. */
  body { margin: 0; background: #fff; }
  .k, .kv-header {
    --font-heading-family: "Archivo", "Archivo zaskok", "Helvetica Neue", Arial, sans-serif;
    --font-body-family: "Archivo", "Archivo zaskok", "Helvetica Neue", Arial, sans-serif;
  }
  .k h1, .k h2, .k h3, .k .k-display, .k .k-h2, .k .k-h3, .k .k-h4,
  .k .kh-fact strong, .k .kh-rev__big b, .k .kh-cta__row strong,
  .k .kh-usp__item strong, .k .kh-soltec__lines strong, .k .kh-faq__item summary,
  .kv-header .kv-mega__card strong, .k .kh-fact--score b, .k .kh-cta__score b, .k .kh-proc__n {
    font-variation-settings: "wdth" 106;
  }
</style>
<style>
  /* Dokument má vyše 9 000 px textu. Bez obsahu sa v ňom nedá nič nájsť,
     preto vedľa neho stojí prilepený zoznam častí. Robí sa pri stavbe, takže
     funguje aj bez skriptu. */
  .kv-legal__mriezka { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  @media (min-width: 1000px) {
    .kv-legal__mriezka { grid-template-columns: minmax(0, 250px) minmax(0, 1fr); gap: 56px; align-items: start; }
    .kv-legal__obsah { position: sticky; top: clamp(96px, 13vh, 148px); }
  }
  .kv-legal__obsah-nadpis {
    margin: 0 0 12px; font-size: 1.2rem; font-weight: 600;
    letter-spacing: .16em; text-transform: uppercase; color: #6b7378;
  }
  .kv-legal__obsah ol { margin: 0; padding: 0; list-style: none; counter-reset: kvc; }
  .kv-legal__obsah li { counter-increment: kvc; border-top: 1px solid rgba(18,23,26,.1); }
  .kv-legal__obsah li:last-child { border-bottom: 1px solid rgba(18,23,26,.1); }
  .kv-legal__obsah a {
    display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 6px;
    padding: 11px 0; font-size: 1.35rem; line-height: 1.45;
    color: #3b4247; text-decoration: none;
    transition: color 240ms ease, transform 320ms cubic-bezier(.16,1,.3,1);
  }
  .kv-legal__obsah a::before {
    content: counter(kvc, decimal-leading-zero);
    font-size: 1.1rem; font-weight: 700; color: #8a6600;
    font-variant-numeric: tabular-nums;
  }
  .kv-legal__obsah a:hover { color: #12171a; transform: translateX(3px); }
  .kv-legal h2 { scroll-margin-top: clamp(96px, 14vh, 156px); }
  .kv-legal { max-width: 78ch; }
  .kv-legal h2 { margin: 2.4rem 0 .8rem; font-size: 2rem; line-height: 1.25; }
  .kv-legal h3, .kv-legal h4 { margin: 2rem 0 .6rem; font-size: 1.6rem; }
  .kv-legal p, .kv-legal li { font-size: 1.55rem; line-height: 1.7; color: #3b4247; }
  .kv-legal ul, .kv-legal ol { margin: 0 0 1.2rem 1.6rem; }
  .kv-legal li { margin-bottom: .5rem; }
  .kv-legal strong { color: #12171a; }
  .kv-legal a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
</style>

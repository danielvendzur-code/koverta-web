    gap: 8px !important;
  }
  .otCookiesNotification button.cookies-btn,
  .otCookiesNotification button {
    min-height: 44px !important;
    padding: 10px 20px !important;
    border-radius: 999px !important;
    border: 1.5px solid #12171a !important;
    background: #fff !important;
    color: #12171a !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    box-shadow: none !important;
    flex: 1 1 auto;
  }
  .otCookiesNotification button[class*="accept" i],
  .otCookiesNotification button[id*="accept" i] {

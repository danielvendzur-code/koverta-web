    background: #fff !important;
    color: #12171a !important;
    border: 1px solid rgba(18, 23, 26, 0.1) !important;
    border-radius: 18px !important;
    box-shadow: 0 4px 8px rgba(18, 23, 26, 0.05), 0 28px 72px rgba(18, 23, 26, 0.16) !important;
    padding: 22px !important;
    gap: 14px !important;
    font-size: 14px !important;
    line-height: 1.5 !important;
  }
  .otCookiesNotification .otCookies-title-banner,
  .otCookiesNotification [class*="title"] {
    color: #12171a !important;
    font-size: 17px !important;
    font-weight: 700 !important;
    line-height: 1.3 !important;
  }
  .otCookiesNotification p,
  .otCookiesNotification [class*="content"],
  .otCookiesNotification [class*="message"] {
    color: rgba(18, 23, 26, 0.72) !important;
    font-size: 14px !important;
    line-height: 1.5 !important;
  }
  .otCookiesNotification a {
    color: #12171a !important;
    text-decoration: underline !important;
    text-underline-offset: 3px;
  }
  .otCookiesNotification .ot-group-btn-corner,
  .otCookiesNotification [class*="group-btn"] {

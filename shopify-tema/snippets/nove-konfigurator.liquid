<style>
  /* Only the frame around the configurator. Nothing here reaches inside
     #SoltecPremium; the palette is the theme's own. */
  :root {
    --kv-ink: #121212;
    --kv-ground: #ffffff;
    --kv-line: rgba(18, 18, 18, .12);
    --kv-muted: rgba(18, 18, 18, .62);
  }
  body { background: var(--kv-ground); color: var(--kv-ink); }

  .kv-bar {
    position: sticky; top: 0; z-index: 40;
    background: var(--kv-ground); border-bottom: 1px solid var(--kv-line);
  }
  .kv-bar__in {
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; min-height: 5.6rem; padding-block: .9rem; flex-wrap: wrap;
  }
  .kv-mark {
    font-family: "Titillium Web", "Trebuchet MS", sans-serif;

<script src="{{ 'kfg-cfg-pages.js' | asset_url }}"></script>
<script>
(function () {
  var PAGES = window.KV_PAGES || {};

  var LABEL = { koverta: 'Prístrešky Koverta', zahrada: 'Záhradné prístrešky Koverta', bio: 'Bioklimatické pergoly Soltec', canopy: 'Pevné prestrešenia Soltec', carport: 'Carport Soltec' };
  var page = new URLSearchParams(location.search).get('page');
  if (!PAGES[page]) page = 'koverta';

  document.querySelectorAll('[data-kv-tab]').forEach(function (a) {
    if (a.dataset.kvTab === page) a.setAttribute('aria-current', 'page');
  });
  /* Skupina výberu: aktívna je tá, v ktorej je otvorený prístrešok. */
  (function () {
    var koren = document.querySelector('[data-kv-skupiny]');
    if (!koren) return;
    var nastav = function (sk) {
      koren.setAttribute('data-aktivna', sk);
      koren.querySelectorAll('[data-kv-skupina]').forEach(function (b) {
        b.setAttribute('aria-selected', String(b.dataset.kvSkupina === sk));
      });
    };
    nastav(/^(koverta|carport)$/.test(page) ? 'auta' : 'dom');
    koren.addEventListener('click', function (e) {
      var b = e.target.closest('[data-kv-skupina]');
      if (b) nastav(b.dataset.kvSkupina);
    });
  })();
  document.title = LABEL[page] + ' | 3D konfigurátor Koverta';
  /* Nadpis stránky stojí hore ako na zvyšku webu; text si berie z nadpisu
     vybraného modelu, ktorý nesie konfigurátor (ten sa pod výberom skryje). */
  var nadpis = document.querySelector('[data-kv-nadpis]');
  var zModelu = (PAGES[page] || '').match(/<h1 class="sp-h2">([^<]*)<\/h1>/);
  if (nadpis && zModelu) nadpis.textContent = zModelu[1];

  // The section markup expects to sit inside #SoltecPremium, and the page
  // script that follows looks that id up the moment it runs.
  var host = document.createElement('div');
  host.id = 'SoltecPremium';
  host.setAttribute('data-sp-root', '');
  host.setAttribute('data-sp-page', page);
  host.innerHTML = PAGES[page];
  var koren = document.getElementById('kv-root');
  // Statická náhrada nadpisu je len pre čítačku bez skriptu — teraz už je
  // na stránke skutočná hlavička konfigurátora, tak ju netreba dvakrát.
  var zaloha = koren.querySelector('[data-k-cfg-zaloha]');
  if (zaloha) zaloha.parentNode.removeChild(zaloha);
  koren.appendChild(host);

  /* Runtime hľadá `#sp-dopyt` aj textové pole dopytu vnútri `#SoltecPremium`.
     Formulár je v stránke staticky, aby ho videl aj prehliadač bez skriptu;
     tu sa presunie pod konfigurátor dovnútra jeho koreňa. */
  var obal = koren.querySelector('[data-k-cta-obal]');
  var dopyt = obal && obal.querySelector('#sp-dopyt');
  if (obal) koren.appendChild(obal);

  /* Prvá otázka formulára sa predvyplní podľa toho, čo si človek skladal. */
  var CO = { koverta: 'Prístrešok pre auto', zahrada: 'Záhradný prístrešok',
             bio: 'Pergola', canopy: 'Pergola', carport: 'Prístrešok pre auto' };
  var co = CO[page];
  if (dopyt && co) {
    var vstup = dopyt.querySelector('[data-k-select-input]');
    var stitok = dopyt.querySelector('[data-k-select-label]');
    var polozka = dopyt.querySelector('[data-k-select-option="' + co + '"]');
    if (vstup && stitok && polozka) {
      vstup.value = co;
      stitok.textContent = co;
      dopyt.querySelectorAll('[data-k-select-option]').forEach(function (o) {
        o.setAttribute('aria-selected', String(o.dataset.kSelectOption === co));
      });
    }
  }

  /* The shared script turns the quote button into a prefilled e-mail when this
     standalone build has no Shopify contact form. */
})();
</script>


<!-- Rozmer z adresy. Tabuľky rozmerov na podstránkach viedli do e-shopu,
     ktorý končí. Teraz vedú sem a rovno s rozmerom: ?w= je šírka, ?l= je
     dĺžka, oboje v milimetroch. Posuvník si hodnotu zarovná na najbližší
     katalógový krok, takže aj nepresné číslo skončí na platnom rozmere. -->
<script>
(function kvRozmerZAdresy() {
  var q;
  try { q = new URLSearchParams(location.search); } catch (e) { return; }
  var w = parseInt(q.get('w'), 10);
  var l = parseInt(q.get('l'), 10);
  if (!w && !l) return;

  var pokusov = 0;
  function nastav() {
    var sw = document.querySelector('[data-sp-w]');
    var sl = document.querySelector('[data-sp-l]');
    /* Posuvníky sú v šablóne od začiatku, ale rozsah v milimetroch im
       nastaví až runtime. Kým je max ešte jednotka zo šablóny, nemá zmysel
       nič nastavovať. */
    var pripravene = sw && sl && Number(sw.max) > 100 && Number(sl.max) > 100;
    if (!pripravene) {
      if (++pokusov > 100) return;
      return window.setTimeout(nastav, 100);
    }
    [[sw, w], [sl, l]].forEach(function (par) {
      var pole = par[0], hodnota = par[1];
      if (!hodnota) return;
      var min = Number(pole.min), max = Number(pole.max);
      if (Number.isFinite(min) && hodnota < min) hodnota = min;
      if (Number.isFinite(max) && hodnota > max) hodnota = max;
      pole.value = String(hodnota);
      pole.dispatchEvent(new Event('input', { bubbles: true }));
      pole.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', nastav);
  else nastav();
})();
</script>

<!-- Rozmer späť do adresy. Kto si niečo vyskladá, chce to poslať ďalej alebo
     si to odložiť na neskôr — a adresa je na to jediné miesto, ktoré si
     poradí aj bez toho, aby sme čokoľvek ukladali do prehliadača. Zápis ide
     cez replaceState, takže tlačidlo Späť ostáva na predošlej stránke, nie
     na predošlom rozmere. -->
<script>
(function kvRozmerDoAdresy() {
  var cakac = null;
  function zapis() {
    var q;
    try { q = new URLSearchParams(location.search); } catch (e) { return; }
    var w = null, l = null;
    if (window.SP_TEST && typeof window.SP_TEST.snapshot === 'function') {
      try { var sn = window.SP_TEST.snapshot(); w = sn.width; l = sn.length; } catch (e) {}
    }
    if (!w || !l) {
      var sw = document.querySelector('[data-sp-w]');
      var sl = document.querySelector('[data-sp-l]');
      if (!sw || !sl || Number(sw.max) <= 100) return;
      w = Number(sw.value); l = Number(sl.value);
    }
    if (!w || !l) return;
    if (q.get('w') === String(w) && q.get('l') === String(l)) return;
    q.set('w', String(w));
    q.set('l', String(l));
    try { history.replaceState(history.state, '', location.pathname + '?' + q.toString()); } catch (e) {}
  }
  function jeRozmer(e) {
    var t = e.target;
    return t && t.matches && t.matches('[data-sp-w], [data-sp-l]');
  }
  /* Počas ťahania sa zapisuje s odstupom, aby adresa neprepisovala pri každom
     pixeli. Po pustení posuvníka (`change`) sa zapíše hneď: je to jedno
     zapísanie, nie stovka, a čakať s ním nie je na čo. Odstup navyše
     nefunguje spoľahlivo v okamihu, keď je vlákno zabraté vykresľovaním —
     časovač sa spustí až po ňom a adresa vtedy meškala aj sekundu. */
  document.addEventListener('input', function (e) {
    if (!jeRozmer(e)) return;
    window.clearTimeout(cakac);
    cakac = window.setTimeout(zapis, 400);
  }, true);
  document.addEventListener('change', function (e) {
    if (!jeRozmer(e)) return;
    window.clearTimeout(cakac);
    zapis();
  }, true);
})();
</script>

<!-- Výzva na celú obrazovku. Ukáže sa len na nízkom okne a len raz — kto ju
     zavrie, už ju neuvidí. Fullscreen nie je nikde podmienkou používania. -->
<script>
(function kvFullscreen() {
  var bar = document.querySelector('[data-kv-fs]');
  if (!bar) return;
  var KEY = 'kv-fs-dismissed';
  var tesno = window.innerHeight < 900 || window.innerWidth < 1280;
  var zavrete = false;
  try { zavrete = localStorage.getItem(KEY) === '1'; } catch (e) {}
  if (!tesno || zavrete || !document.documentElement.requestFullscreen) return;

  /* Výzva stála vo vlastnom páse nad konfigurátorom a brala 58 px práve tam,
     kde má byť vidieť vizualizáciu. Patrí vedľa prepínača Konfigurátor /
     Kalkulácia — je to o tom istom a riadok je tam aj tak poloprázdny. */
  var tabs = document.querySelector('.sp-cfg__tabs');
  if (tabs && tabs.parentNode) {
    var riadok = document.createElement('div');
    riadok.className = 'kv-tabrow';
    tabs.parentNode.insertBefore(riadok, tabs);
    riadok.appendChild(tabs);
    riadok.appendChild(bar);
  }
  bar.hidden = false;
  bar.querySelector('[data-kv-fs-go]').addEventListener('click', function () {
    var el = document.documentElement;
    if (el.requestFullscreen) { el.requestFullscreen().catch(function () {}); }
    /* Fullscreen prehliadača sám osebe nič nerieši — stránka pod ním ostane
       bežnou stránkou a k prístrešku sa treba doscrollovať. Otvoríme rovno aj
       pracovný režim konfigurátora, takže sa po kliknutí ocitneš v ňom celom. */
    var otvor = document.querySelector('[data-sp-cfg-open]');
    var uzJe = document.querySelector('.sp-cfg.is-full');
    if (otvor && !uzJe) otvor.click();
    bar.hidden = true;
  });
  bar.querySelector('[data-kv-fs-close]').addEventListener('click', function () {
    bar.hidden = true;
    try { localStorage.setItem(KEY, '1'); } catch (e) {}
  });
})();
</script>


<!-- ===================================================== PODKLAD -->
<section class="k-band k-bone kh-mat" aria-labelledby="podkladTitle">
  <div class="k-rules" aria-hidden="true"></div>
  <div class="k-wrap">
    <header class="k-head k-head--split">
      <div class="k-head__title">
        <p class="k-eyebrow k-rise">Podklad a kotvenie</p>

<style>
  /* Len pre túto statickú plochu — v téme tieto premenné dodáva Shopify. */
  body { margin: 0; background: #fff; }
  .k, .kv-header {
    --font-heading-family: "Archivo", "Archivo zaskok", "Helvetica Neue", Arial, sans-serif;
    --font-body-family: "Archivo", "Archivo zaskok", "Helvetica Neue", Arial, sans-serif;
  }
  .k h1, .k h2, .k h3, .k .k-display, .k .k-h2, .k .k-h3, .k .k-h4,
  .k .kh-fact strong, .k .kh-rev__big b, .k .kh-cta__row strong,
  .k .kh-usp__item strong, .k .kh-soltec__lines strong, .k .kh-faq__item summary,
  .kv-header .kv-mega__card strong, .k .kh-fact--score b, .k .kh-cta__score b, .k .kh-proc__n {
    font-variation-settings: "wdth" 106;
  }
</style>
<style>
  .kh-404__uvod { max-width: 78ch; }
  .kh-404__spodok { margin-top: 22px; }
  .kh-404__tip { margin-top: 20px; font-weight: 500; }
  .kh-404__dlazdica.je-tip { border-color: var(--k-amber-deep); box-shadow: 0 0 0 1px var(--k-amber-deep); }
  .kh-404__rad { display:grid; gap:12px; margin-top:26px;
    grid-template-columns:repeat(auto-fill,minmax(258px,1fr)); }
  .kh-404__dlazdica { display:block; padding:16px 18px; border:1px solid var(--k-hair);
    border-radius:var(--k-r-sm); background:var(--k-white); text-decoration:none; color:inherit;
    transition:border-color .2s var(--k-ease), transform .2s var(--k-ease); }
  .kh-404__dlazdica:hover { border-color:var(--k-ink); transform:translateY(-2px); }
  .kh-404__dlazdica strong { display:block; font-family:var(--k-head); font-size:16px; color:var(--k-ink); }
  .kh-404__dlazdica span { display:block; margin-top:4px; font-size:13.5px; line-height:1.55; color:var(--k-muted); }
</style>
<script>
/* Starý web mal celkom inú štruktúru adries. Keď sa v tej starej adrese dá
   rozoznať, čo návštevník hľadal, ponúkneme mu rovno správnu stránku —
   ale nepresmerujeme ho, lebo odhad sa môže mýliť a nič horšie než skok
   na nesprávnu stránku tu nie je. */
(function () {
  var mapa = [
    [/pergol/, '/bioklimaticke-pergoly/', 'Bioklimatické pergoly'],
    [/carport|soltec-?carport/, '/carport-soltec/', 'Hliníkové carporty Soltec'],
    [/kuchyn|kitchen/, '/outdoor-kuchyne/', 'Vonkajšie kuchyne'],
    [/tien|zip|rolet|brisolej|screen|shutter/, '/tienenie/', 'Tienenie'],
    [/prestres|zastres|canopy|glassport/, '/pevne-prestresenia/', 'Pevné prestrešenia'],
    [/teras|zahrad|garden/, '/zahradne-prestresky-placeholder/', 'Prístrešky nad terasu'],
    [/auto|auta|car(?!port)|pristres|prístres/, '/pristresky-pre-auta/', 'Prístrešky pre autá'],
    [/realizac|galeri|gallery|reference/, '/realizacie/', 'Realizácie'],
    [/kontakt|contact/, '/kontakt/', 'Kontakt'],
    [/konfigur|configur|3d/, '/konfigurator/', '3D konfigurátor'],
    [/podmienk|terms/, '/obchodne-podmienky/', 'Obchodné podmienky'],
    [/sukrom|súkrom|privacy|gdpr/, '/ochrana-sukromia/', 'Ochrana súkromia'],
    [/reklamac|complaint/, '/reklamacie/', 'Reklamácie']
  ];
  var cesta = decodeURIComponent(location.pathname + location.search).toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  for (var i = 0; i < mapa.length; i++) {
    if (!mapa[i][0].test(cesta)) continue;
    var ciel = mapa[i][1];
    if (ciel.indexOf('placeholder') > -1) ciel = '/zahradne-pristresky/';
    var box = document.querySelector('[data-k-404-tip]');
    if (!box) return;
    box.innerHTML = 'Podľa adresy ste hľadali skôr toto: <a href="' + ciel + '">' + mapa[i][2] + '</a>.';
    box.hidden = false;
    var dl = document.querySelector('.kh-404__dlazdica[href="' + ciel + '"]');
    if (dl) dl.classList.add('je-tip');
    return;
  }
})();
</script>
